      "json_request": { "argv": ["project", "settings", "apply", "--project-root", ".", "--intent", "intents/main_scene.json", "--json"] }
    },
    {
      "name": "project_autoload_list",
      "argv": ["project", "autoload", "list", "--project-root", "<path>"],
      "json_request": { "argv": ["project", "autoload", "list", "--project-root", ".", "--json"] }
    },
    {
      "name": "project_autoload_apply",
      "argv": ["project", "autoload", "apply", "--project-root", "<path>"],
      "options": ["--intent", "--file", "--dry-run"],
      "json_request": { "argv": ["project", "autoload", "apply", "--project-root", ".", "--intent", "intents/autoload_game_state.json", "--json"] }
    },
    {
      "name": "project_plugins_list",
      "argv": ["project", "plugins", "list", "--project-root", "<path>"],
      "json_request": { "argv": ["project", "plugins", "list", "--project-root", ".", "--json"] }
    },
    {
      "name": "project_plugins_enable",
      "argv": ["project", "plugins", "enable", "--project-root", "<path>"],
      "options": ["--plugin", "--path", "--dry-run"],
      "json_request": { "argv": ["project", "plugins", "enable", "--project-root", ".", "--plugin", "godot_power_ai", "--json"] }
    },
    {
      "name": "project_plugins_apply",
      "argv": ["project", "plugins", "apply", "--project-root", "<path>"],
