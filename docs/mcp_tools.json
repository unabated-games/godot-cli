      "options": ["--tags", "--query"],
      "json_request": { "argv": ["catalog", "search", "--project-root", ".", "--tags", "ui,button", "--json"] }
    },
    {
      "name": "catalog_export",
      "argv": ["catalog", "export", "--project-root", "<path>"],
      "options": ["--output", "--dry-run"],
      "json_request": { "argv": ["catalog", "export", "--project-root", ".", "--output", "AGENTS.md", "--json"] }
    },
    {
      "name": "project_input_list",
      "argv": ["project", "input", "list", "--project-root", "<path>"],
