{
  "name": "godot-cli",
  "version": "0.1.0",
  "description": "Godot .tscn/.tres load, validate, edit, and save tooling for scripts and MCP agents.",
  "binary": "godot-cli",
  "request_envelope": {
    "argv": ["command", "subcommand", "positional...", "--option", "value"],
    "options": { "json": true },
    "response": {
      "ok": true,
      "data": {},
      "messages": []
    }
  },
  "tools": [
    {
      "name": "ping",
      "argv": ["ping"],
      "json_request": { "argv": ["ping", "--json"] }
    },
    {
      "name": "uid_encode",
      "argv": ["uid", "encode", "<id>"],
      "json_request": { "argv": ["uid", "encode", "1350303725746704497", "--json"] }
    },
    {
      "name": "uid_decode",
      "argv": ["uid", "decode", "<uid-text>"],
      "json_request": { "argv": ["uid", "decode", "uid://tidkmw585t0t", "--json"] }
    },
    {
      "name": "uid_create_for_path",
      "argv": ["uid", "create-for-path", "<res-path>"],
      "json_request": { "argv": ["uid", "create-for-path", "res://main.tscn", "--json"] }
    },
    {
      "name": "uid_scene_id_generate",
      "argv": ["uid", "scene-id", "generate"],
      "json_request": { "argv": ["uid", "scene-id", "generate", "--json"] }
    },
    {
      "name": "uid_cache_list",
      "argv": ["uid", "cache", "list", "--project-root", "<path>"],
      "json_request": {
        "argv": ["uid", "cache", "list", "--project-root", ".", "--json"]
      }
    },
    {
      "name": "uid_cache_lookup",
      "argv": ["uid", "cache", "lookup", "<uid-or-path>", "--project-root", "<path>"],
      "json_request": {
        "argv": ["uid", "cache", "lookup", "uid://tidkmw585t0t", "--project-root", ".", "--json"]
      }
    },
    {
      "name": "uid_session_import",
      "argv": ["uid", "session", "import", "--referrer", "<res-path>", "--from", "<godot-saved.tscn>", "--project-root", "<path>"],
      "json_request": {
        "argv": ["uid", "session", "import", "--referrer", "res://sample.tscn", "--from", "sample_godot_saved.tscn", "--project-root", ".", "--json"]
      }
    },
    {
      "name": "scene_new",
      "argv": ["scene", "new", "--output", "<file.tscn>"],
      "options": ["--root-name", "--root-type", "--project-root", "--dry-run"],
      "description": "Create a new empty scene with gd_scene header and root node.",
      "json_request": { "argv": ["scene", "new", "--output", "main.tscn", "--root-name", "Main", "--root-type", "Node2D", "--json"] }
    },
    {
      "name": "scene_refs",
      "argv": ["scene", "refs", "<file.tscn>"],
      "options": ["--project-root"],
      "description": "List ext_resource entries; with --project-root resolves filesystem paths and existence.",
      "json_request": { "argv": ["scene", "refs", "main.tscn", "--project-root", ".", "--json"] }
    },
    {
      "name": "scene_ext_add",
      "argv": ["scene", "ext", "add", "<file.tscn>"],
      "options": ["--type", "--path", "--output", "--project-root", "--dry-run"],
      "json_request": { "argv": ["scene", "ext", "add", "main.tscn", "--type", "Script", "--path", "res://player.gd", "--json"] }
    },
    {
      "name": "scene_ext_remove",
      "argv": ["scene", "ext", "remove", "<file.tscn>", "<id>"],
      "options": ["--output", "--project-root", "--dry-run"],
      "json_request": { "argv": ["scene", "ext", "remove", "main.tscn", "1_abc12", "--json"] }
    },
    {
      "name": "scene_sub_add",
      "argv": ["scene", "sub", "add", "<file.tscn>"],
      "options": ["--type", "--property", "--value", "--output", "--project-root", "--dry-run"],
      "json_request": { "argv": ["scene", "sub", "add", "main.tscn", "--type", "RectangleShape2D", "--property", "size", "--value", "Vector2(16, 32)", "--json"] }
    },
    {
      "name": "scene_sub_remove",
      "argv": ["scene", "sub", "remove", "<file.tscn>", "<id>"],
      "options": ["--output", "--project-root", "--dry-run"],
      "json_request": { "argv": ["scene", "sub", "remove", "main.tscn", "RectangleShape2D_abc12", "--json"] }
    },
    {
      "name": "scene_inspect",
      "argv": ["scene", "inspect", "<file.tscn>"],
      "options": ["--no-validate", "--no-parse-properties"],
      "description": "Returns section headers, property_count, and with --json parsed properties (name, kind, value) per section.",
      "json_request": { "argv": ["scene", "inspect", "main.tscn", "--json"] }
    },
    {
      "name": "scene_node_list",
      "argv": ["scene", "node", "list", "<file.tscn>"],
      "description": "List scene nodes with name, type, parent, viewport path, section_line, and unique_id.",
      "json_request": { "argv": ["scene", "node", "list", "main.tscn", "--json"] }
    },
    {
      "name": "scene_node_get",
      "argv": ["scene", "node", "get", "<file.tscn>", "<node-path>"],
      "options": ["--node-name", "--parent"],
      "description": "Get one node by viewport path positional or --node-name with optional --parent.",
      "json_request": { "argv": ["scene", "node", "get", "main.tscn", "/root/Player", "--json"] }
    },
    {
      "name": "scene_node_add",
      "argv": ["scene", "node", "add", "<file.tscn>"],
      "options": ["--parent", "--name", "--type", "--property", "--value", "--output", "--project-root", "--dry-run"],
      "description": "Add a child node under a viewport parent path (e.g. /root/Main).",
      "json_request": { "argv": ["scene", "node", "add", "main.tscn", "--parent", "/root/Main", "--name", "Player", "--type", "CharacterBody2D", "--json"] }
    },
    {
      "name": "scene_node_remove",
      "argv": ["scene", "node", "remove", "<file.tscn>", "<node-path>"],
      "options": ["--recursive", "--output", "--project-root", "--dry-run"],
      "json_request": { "argv": ["scene", "node", "remove", "main.tscn", "/root/Main/Player", "--json"] }
    },
    {
      "name": "scene_node_rename",
      "argv": ["scene", "node", "rename", "<file.tscn>", "<node-path>"],
      "options": ["--name", "--output", "--project-root", "--dry-run"],
      "json_request": { "argv": ["scene", "node", "rename", "main.tscn", "/root/Main/Player", "--name", "Hero", "--json"] }
    },
    {
      "name": "scene_node_reparent",
      "argv": ["scene", "node", "reparent", "<file.tscn>", "<node-path>"],
      "options": ["--parent", "--output", "--project-root", "--dry-run"],
      "json_request": { "argv": ["scene", "node", "reparent", "main.tscn", "/root/Main/Hero", "--parent", "/root/Main", "--json"] }
    },
    {
      "name": "scene_validate",
      "argv": ["scene", "validate", "<file.tscn>", "--project-root", "<path>"],
      "json_request": {
        "argv": ["scene", "validate", "main.tscn", "--project-root", ".", "--json"]
      },
      "exit_codes": { "0": "no errors", "1": "validation errors" }
    },
    {
      "name": "scene_validate_batch",
      "argv": ["scene", "validate-batch", "<files...>", "--project-root", "<path>"],
      "json_request": {
        "argv": ["scene", "validate-batch", "a.tscn", "b.tscn", "--project-root", ".", "--json"]
      }
    },
    {
      "name": "scene_set_property",
      "argv": ["scene", "set-property", "<file>", "<section-index>", "<key>", "<value>"],
      "options": ["--output", "--resource-path", "--no-prepare-save", "--raw-value"],
      "json_request": {
        "argv": ["scene", "set-property", "main.tscn", "2", "visible", "false", "--json"]
      }
    },
    {
      "name": "scene_normalize",
      "argv": ["scene", "normalize", "<file>", "--output", "<out>"],
      "options": ["--resource-path", "--no-prepare-save", "--normalize-properties", "--godot-save-format"],
      "description": "Repair IDs and sort ext_resources for save; optional --normalize-properties rewrites property values via Variant parse/format.",
      "json_request": {
        "argv": ["scene", "normalize", "main.tscn", "--output", "out.tscn", "--resource-path", "res://main.tscn", "--json"]
      }
    },
    {
      "name": "scene_retarget_ext",
      "argv": ["scene", "retarget-ext", "--from", "<res-path>", "--to", "<res-path>", "<file>"],
      "json_request": {
        "argv": ["scene", "retarget-ext", "--from", "res://old.gd", "--to", "res://new.gd", "main.tscn", "--json"]
      }
    },
    {
      "name": "scene_compare_godot",
      "argv": ["scene", "compare-godot", "<file.tscn>", "<godot-reference.tscn>"],
      "json_request": {
        "argv": ["scene", "compare-godot", "sample.tscn", "sample_godot_saved.tscn", "--json"]
      }
    },
    {
      "name": "scene_round_trip",
      "argv": ["scene", "round-trip", "<file>"],
      "options": ["--dry-run"],
      "json_request": { "argv": ["scene", "round-trip", "main.tscn", "--dry-run", "--json"] }
    },
    {
      "name": "resource_inspect",
      "argv": ["resource", "inspect", "<file.tres>"],
      "options": ["--no-validate", "--no-parse-properties"],
      "description": "Returns section headers, property_count, and with --json parsed properties (name, kind, value) per section.",
      "json_request": { "argv": ["resource", "inspect", "mat.tres", "--json"] }
    },
    {
      "name": "resource_validate",
      "argv": ["resource", "validate", "<file.tres>", "--project-root", "<path>"],
      "json_request": {
        "argv": ["resource", "validate", "mat.tres", "--project-root", ".", "--json"]
      }
    },
    {
      "name": "resource_validate_batch",
      "argv": ["resource", "validate-batch", "<files...>"],
      "json_request": { "argv": ["resource", "validate-batch", "a.tres", "b.tres", "--json"] }
    },
    {
      "name": "resource_set_property",
      "argv": ["resource", "set-property", "<file>", "<section-index>", "<key>", "<value>"],
      "options": ["--output", "--resource-path", "--no-prepare-save", "--raw-value"]
    },
    {
      "name": "resource_normalize",
      "argv": ["resource", "normalize", "<file>", "--output", "<out>"],
      "options": ["--resource-path", "--no-prepare-save", "--normalize-properties", "--godot-save-format"],
      "description": "Repair IDs and sort ext_resources for save; optional --normalize-properties rewrites property values via Variant parse/format."
    },
    {
      "name": "resource_retarget_ext",
      "argv": ["resource", "retarget-ext", "--from", "<res-path>", "--to", "<res-path>", "<file>"]
    },
    {
      "name": "resource_round_trip",
      "argv": ["resource", "round-trip", "<file>"],
      "options": ["--dry-run"]
    }
  ]
}
