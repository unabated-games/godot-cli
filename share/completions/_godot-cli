_godot_cli_global_options=( '--help:Show help and exit' '--version:Show version and exit' '--json:Emit machine-readable JSON output' '--verbose:Enable verbose logging on stderr' '--request:Run using a JSON command descriptor' '--request-file:Read JSON command descriptor from a file' '--request-stdin:Read JSON command descriptor from stdin' )

_godot-cli() {
    local -a _godot_cli_reply subcommands options names
    local path="" word
    integer index

    for (( index = 2; index < CURRENT; index++ )); do
        word="${words[index]}"
        [[ "$word" == -* ]] && continue
        _godot_cli_children "$path"
        names=( ${_godot_cli_reply%%:*} )
        if (( ${names[(I)$word]} )); then
            path="${path:+$path }$word"
        fi
    done

    _godot_cli_children "$path"
    subcommands=( "${_godot_cli_reply[@]}" )
    _godot_cli_options "$path"
    options=( "${_godot_cli_reply[@]}" )

    (( ${#subcommands} )) && _describe -t commands 'command' subcommands
    (( ${#options} )) && _describe -t options 'option' options
    _describe -t globals 'global option' _godot_cli_global_options
    _files
}

_godot-cli "$@"
