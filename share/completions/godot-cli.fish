# fish completion for godot-cli — generated by `godot-cli completions fish`.
#
# Install: save as ~/.config/fish/completions/godot-cli.fish

function __godot_cli_children
    switch "$argv[1]"
        case ''
            echo 'help ping uid scene resource catalog batch project completions man reference mcp'
        case 'uid'
            echo 'encode decode create-for-path scene-id cache session'
        case 'uid scene-id'
            echo 'generate'
        case 'uid cache'
            echo 'list lookup'
        case 'uid session'
            echo 'import'
        case 'scene'
            echo 'new refs ext sub inspect node connection instance template plan apply diff restore validate validate-batch set-property normalize retarget-ext round-trip compare-godot'
        case 'scene ext'
            echo 'add remove'
        case 'scene sub'
            echo 'add remove'
        case 'scene node'
            echo 'list get add remove rename reparent'
        case 'scene connection'
            echo 'list add remove'
        case 'scene instance'
            echo 'add'
        case 'scene template'
            echo 'list show copy'
        case 'resource'
            echo 'new sub ext inspect validate validate-batch set-property normalize retarget-ext round-trip compare-godot'
        case 'resource sub'
            echo 'add remove'
        case 'resource ext'
            echo 'add remove'
        case 'catalog'
            echo 'add relink scan list show validate search export'
        case 'project'
            echo 'show move apply input settings autoload plugins rendering physics'
        case 'project input'
            echo 'list apply validate'
        case 'project settings'
            echo 'list get set apply validate'
        case 'project autoload'
            echo 'list apply validate'
        case 'project plugins'
            echo 'list enable disable apply validate'
        case 'project rendering'
            echo 'list apply validate'
        case 'project physics'
            echo 'list apply validate'
        case '*'
            echo ''
    end
end

# Rebuild the command path from the words typed so far, ignoring flags
# and any word that is not a child of the path resolved before it.
function __godot_cli_path
    set -l tokens (commandline -opc)
    set -l path ''
    for token in $tokens[2..-1]
        if string match -q -- '-*' $token
            continue
        end
        set -l children (string split ' ' -- (__godot_cli_children "$path"))
        if contains -- $token $children
            if test -z "$path"
                set path $token
            else
                set path "$path $token"
            end
        end
    end
    echo $path
end

function __godot_cli_at
    set -l current (__godot_cli_path)
    test "$current" = "$argv[1]"
end

