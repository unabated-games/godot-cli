{
  "ops": [
    {
      "op": "ext_add",
      "type": "FontFile",
      "path": "res://fonts/LilitaOne-Regular.ttf",
      "id_hint": "lilita"
    },
    {
      "op": "ext_add",
      "type": "Texture2D",
      "path": "res://art/gem.png",
      "id_hint": "gem"
    },
    {
      "op": "sub_add",
      "type": "StyleBoxFlat",
      "id_hint": "card",
      "properties": {
        "content_margin_left": 40.0,
        "content_margin_top": 28.0,
        "content_margin_right": 40.0,
        "content_margin_bottom": 36.0,
        "bg_color": "Color(1, 0.957, 0.839, 1)",
        "border_width_left": 4,
        "border_width_top": 4,
        "border_width_right": 4,
        "border_width_bottom": 4,
        "border_color": "Color(0.106, 0.082, 0.188, 1)",
        "corner_radius_top_left": 24,
        "corner_radius_top_right": 24,
        "corner_radius_bottom_right": 24,
        "corner_radius_bottom_left": 24,
        "shadow_color": "Color(0.106, 0.082, 0.188, 1)",
        "shadow_size": 1,
        "shadow_offset": "Vector2(0, 8)"
      }
    },
    {
      "op": "sub_add",
      "type": "StyleBoxFlat",
      "id_hint": "pill",
      "properties": {
        "content_margin_left": 14.0,
        "content_margin_top": 4.0,
        "content_margin_right": 18.0,
        "content_margin_bottom": 4.0,
        "bg_color": "Color(0.106, 0.082, 0.188, 1)",
