        "theme_override_colors/font_color": "Color(0.29, 0.25, 0.42, 1)",
        "theme_override_fonts/font": "ExtResource(\"FontFile_lilita\")",
        "theme_override_font_sizes/font_size": 22
      }
    },
    {
      "op": "instance_add",
      "parent": "/root/HUD/Center/TitleCard/Column",
      "name": "PlayButton",
      "catalog_id": "ui/big_button",
      "properties": {
        "size_flags_horizontal": 4
      }
    },
    {
      "op": "node_add",
      "parent": "/root/HUD/Center",
      "name": "GameOverCard",
      "type": "PanelContainer",
      "unique_name": true,
      "properties": {
        "visible": false,
        "theme_override_styles/panel": "SubResource(\"StyleBoxFlat_card\")"
      }
    },
    {
      "op": "node_add",
      "parent": "/root/HUD/Center/GameOverCard",
      "name": "Column",
      "type": "VBoxContainer",
      "properties": {
        "theme_override_constants/separation": 14
      }
    },
    {
      "op": "node_add",
      "parent": "/root/HUD/Center/GameOverCard/Column",
      "name": "Title",
      "type": "Label",
      "properties": {
        "text": "\"Out of hearts\"",
        "horizontal_alignment": 1,
        "theme_override_colors/font_color": "Color(0.106, 0.082, 0.188, 1)",
        "theme_override_fonts/font": "ExtResource(\"FontFile_lilita\")",
        "theme_override_font_sizes/font_size": 56
      }
    },
    {
      "op": "node_add",
      "parent": "/root/HUD/Center/GameOverCard/Column",
      "name": "FinalScore",
      "type": "Label",
      "properties": {
        "text": "\"You grabbed 0 gems\"",
        "horizontal_alignment": 1,
        "theme_override_colors/font_color": "Color(0.29, 0.25, 0.42, 1)",
        "theme_override_fonts/font": "ExtResource(\"FontFile_lilita\")",
        "theme_override_font_sizes/font_size": 24
      },
      "unique_name": true
    },
    {
      "op": "instance_add",
      "parent": "/root/HUD/Center/GameOverCard/Column",
      "name": "RetryButton",
      "catalog_id": "ui/big_button",
      "properties": {
        "size_flags_horizontal": 4,
        "text": "\"Try again\""
      }
