        "stretch_mode": 5
      }
    },
    {
      "op": "node_add",
      "parent": "/root/HUD/TopBar/Row/ScorePill/ScoreRow",
      "name": "Score",
      "type": "Label",
      "properties": {
        "text": "\"0\"",
        "horizontal_alignment": 1,
        "theme_override_colors/font_color": "Color(1, 0.957, 0.839, 1)",
        "theme_override_fonts/font": "ExtResource(\"FontFile_lilita\")",
        "theme_override_font_sizes/font_size": 30,
        "custom_minimum_size": "Vector2(40, 0)"
      },
      "unique_name": true
    },
    {
      "op": "node_add",
      "parent": "/root/HUD",
      "name": "Center",
      "type": "CenterContainer",
      "properties": {
        "anchors_preset": 15,
        "anchor_right": 1.0,
        "anchor_bottom": 1.0,
        "grow_horizontal": 2,
        "grow_vertical": 2,
        "mouse_filter": 2
      }
    },
    {
      "op": "node_add",
      "parent": "/root/HUD/Center",
      "name": "TitleCard",
      "type": "PanelContainer",
      "unique_name": true,
      "properties": {
        "theme_override_styles/panel": "SubResource(\"StyleBoxFlat_card\")"
      }
    },
    {
      "op": "node_add",
      "parent": "/root/HUD/Center/TitleCard",
