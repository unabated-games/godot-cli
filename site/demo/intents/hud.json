    },
    {
      "op": "instance_add",
      "parent": "/root/HUD/TopBar/Row/Hearts",
      "name": "Heart1",
      "catalog_id": "ui/heart"
    },
    {
      "op": "instance_add",
      "parent": "/root/HUD/TopBar/Row/Hearts",
      "name": "Heart2",
      "catalog_id": "ui/heart"
    },
    {
      "op": "instance_add",
      "parent": "/root/HUD/TopBar/Row/Hearts",
