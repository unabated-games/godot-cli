    {
      "op": "connection_add",
      "from": "/root/HUD/Center/TitleCard/Column/PlayButton",
      "signal": "pressed",
      "to": "/root/HUD",
      "method": "_on_play_pressed"
    },
    {
      "op": "connection_add",
      "from": "/root/HUD/Center/GameOverCard/Column/RetryButton",
      "signal": "pressed",
      "to": "/root/HUD",
      "method": "_on_retry_pressed"
    }
  ]
