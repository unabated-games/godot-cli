        "border_width_right": 3,
        "border_width_bottom": 3,
        "border_color": "Color(1, 0.957, 0.839, 1)",
        "corner_radius_top_left": 16,
        "corner_radius_top_right": 16,
        "corner_radius_bottom_right": 16,
        "corner_radius_bottom_left": 16,
        "shadow_color": "Color(0.106, 0.082, 0.188, 1)",
        "shadow_size": 0,
        "shadow_offset": "Vector2(0, 0)"
      }
    },
    {
      "op": "node_add",
      "parent": "/root/HUD",
      "name": "TopBar",
      "type": "MarginContainer",
      "properties": {
        "anchors_preset": 10,
        "anchor_right": 1.0,
        "offset_bottom": 72.0,
        "grow_horizontal": 2,
        "mouse_filter": 2,
        "theme_override_constants/margin_left": 20,
        "theme_override_constants/margin_top": 14,
        "theme_override_constants/margin_right": 20,
        "theme_override_constants/margin_bottom": 8
      }
    },
    {
      "op": "node_add",
      "parent": "/root/HUD/TopBar",
      "name": "Row",
      "type": "HBoxContainer",
      "properties": {
        "mouse_filter": 2
      }
    },
    {
      "op": "node_add",
      "parent": "/root/HUD/TopBar/Row",
      "name": "Hearts",
      "type": "HBoxContainer",
      "unique_name": true,
      "properties": {
        "theme_override_constants/separation": 6
